# API base URL for the HRM backend.
# When using the built-in mock API layer this value is ignored.
VITE_API_BASE_URL=http://localhost:4000/api

# Toggle the mock API layer (true) vs. real HTTP backend (false).
# MUST be false in production. When true the app never contacts the backend at
# all: it serves fabricated data and accepts a hard-coded demo password, so a
# copied-as-is template would produce a site that appears to work and is not
# connected to anything. Set to true only for offline UI work.
VITE_USE_MOCK_API=false
